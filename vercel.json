{
  "version": 2,
  "framework": "vite",
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "^/(.*\\.(png|jpg|jpeg|svg|ico|json|js|css|woff2?|ttf|eot))$",
      "dest": "/$1"
    },
    {
      "src": "^/.*",
      "dest": "/index.html"
    }
  ]
}
